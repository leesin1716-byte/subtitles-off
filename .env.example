# Copy to .env.local for local development. Never commit real values.

# Qloo hackathon key (sent as the X-Api-Key header, server-side only).
QLOO_API_KEY=your-qloo-hackathon-key
# Optional. Defaults to the hackathon host.
QLOO_BASE_URL=https://hackathon.api.qloo.com
# mock | live. Default: live when QLOO_API_KEY is set, otherwise mock.
# Production deployments (VERCEL_ENV=production) refuse to run without a key.
QLOO_MODE=

# Claude planner through the Anthropic API (tried first). Leave empty to skip it.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high
CLAUDE_EFFORT=low
# New Claude-planned plans per server instance per UTC day (default 60); compare baselines count separately against the same cap.
CLAUDE_DAILY_PLAN_CAP=
# Optional: append the token usage of every Claude request to this file as JSON lines.
CLAUDE_USAGE_LOG=

# LLM planner through Vercel AI Gateway. On Vercel, OIDC is used automatically.
# Leave empty to run the rule-based planner only.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-4.1-mini
# off disables the LLM planner even when a gateway key is present.
LLM_MODE=

# Daily health cron (/api/health). Vercel sends it as a Bearer token; without it production skips the deep check.
CRON_SECRET=
