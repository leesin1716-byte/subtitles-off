# Copy to .env.local for local development. Never commit real values.

# Qloo hackathon key (sent as the X-Api-Key header, server-side only).
QLOO_API_KEY=your-qloo-hackathon-key
# Optional. Defaults to the hackathon host.
QLOO_BASE_URL=https://hackathon.api.qloo.com
# mock | live. Default: live when QLOO_API_KEY is set, otherwise mock.
# Production deployments (VERCEL_ENV=production) refuse to run without a key.
QLOO_MODE=

# LLM planner through Vercel AI Gateway. On Vercel, OIDC is used automatically.
# Leave empty to run the rule-based planner only.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-4.1-mini
# off disables the LLM planner even when a gateway key is present.
LLM_MODE=
